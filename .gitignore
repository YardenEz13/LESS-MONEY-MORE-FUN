node_modules/
dist/
*.tsbuildinfo
.env
.env.local
.expo/
.DS_Store

# Native projects are generated from app.json by `expo prebuild` — the config
# is the source of truth, not the output. Editing these by hand is lost on the
# next prebuild.
apps/mobile/android/
apps/mobile/ios/

# Pipeline output (generated, not source of truth for the repo)
data/generated/

# Cowork session workspaces. These hold .credentials.json and saved browser
# profiles with live session cookies — never commit one.
local_*/
**/.browser-profiles/

# Validation progress cache (regenerable, chatty)
collected/easy/.verified-cache.json
data/generated/link-check.log

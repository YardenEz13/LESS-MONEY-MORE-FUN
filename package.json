{
  "name": "smart-benefits-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-auth contextual recall for Israeli club benefits, discounts and gift cards (MVP)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "extract": "npm run -w @sbr/extraction start --",
    "scrape:easy": "node scripts/scrape-easy.mjs",
    "status": "node scripts/status.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "validate:easy": "node scripts/validate-easy.mjs",
    "mine:merchants": "node scripts/mine-merchants.mjs",
    "backfill:merchants": "node scripts/backfill-merchants.mjs",
    "test:scripts": "node scripts/easy-category.test.mjs && node scripts/scrape-easy.test.mjs && node scripts/scrape-keeps-verification.test.mjs && node scripts/validate-easy.test.mjs && node scripts/extract-easy.test.mjs && node scripts/publish-catalog.test.mjs",
    "publish:catalog": "node scripts/publish-catalog.mjs",
    "unpublish": "node scripts/unpublish.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "extract:easy": "node scripts/extract-easy.mjs",
    "export:queue": "node scripts/export-queue.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
